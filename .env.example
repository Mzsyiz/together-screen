PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173,http://localhost:3000
DATA_DIR=./data
SESSION_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false

# Public STUN is enough on many networks. Add TURN for strict NAT or corporate networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Recommended with coturn. Never commit the real shared secret to Git.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional Volcengine WebRTC Transmission Network (WTN).
# Keep WTN_APP_KEY server-side. The browser only receives short-lived JWTs.
WTN_APP_ID=
WTN_APP_KEY=
WTN_BUSINESS_ID=
WTN_API_BASE_URL=https://wtn.volcvideo.com/webrtc
WTN_TOKEN_TTL_SECONDS=600

# Optional Volcengine Real-Time Communication (RTC).
# Keep RTC_APP_KEY server-side. Browsers receive only short-lived room tokens.
RTC_APP_ID=
RTC_APP_KEY=
RTC_BUSINESS_ID=
RTC_TOKEN_TTL_SECONDS=7200
